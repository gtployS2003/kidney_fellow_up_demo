+        prophylaxis: [['Bactrim (400/80)', '2 tab BID'], ['Acyclovir (200)', '1 tab BID'], ['Lasix', '(40) 1 tab OD'], ['Sodamint', '(650) 1 tab BID'], ['CaCO3', '(835) 1 tab OD'], ['Vit D2 (20,000 iu)', '1/wk'], ['Statin', 'Atorvastatin (40) ½ tab hs']],
